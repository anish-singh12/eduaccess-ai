
# ============================================================
# EduAccess AI - Environment Configuration Template
# COPY THIS FILE TO .env IN YOUR server/ DIRECTORY AND FILL IN VALUES
# NEVER COMMIT YOUR REAL .env FILE TO VERSION CONTROL
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.<your-host>.mongodb.net/eduaccess?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Security
# Generate a strong 64-char key in PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# AI Provider Configuration
# Supported providers: 'openai' (default), 'groq', 'anthropic', 'gemini', or 'custom'
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional custom base URL (useful for OpenAI-compatible proxies, Groq, Ollama, etc.)
# Examples:
# For Groq: https://api.groq.com/openai/v1 (Model: llama-3.3-70b-versatile)
# For DeepSeek / OpenRouter: https://openrouter.ai/api/v1
# For Local Ollama: http://localhost:11434/v1
AI_BASE_URL=

# Rate Limiting (Requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=15

# File Upload Settings
MAX_FILE_SIZE_BYTES=5242880
