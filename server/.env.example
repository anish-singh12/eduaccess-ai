# -----------------------------------------------------------------------------
# EduAccess AI — Server Environment Configuration
# -----------------------------------------------------------------------------

# Server Environment & Port
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# For multiple production origins (e.g. Vercel main + preview), use comma-separated CLIENT_ORIGINS:
# CLIENT_ORIGINS=https://eduaccess-learning.vercel.app,https://eduaccess-lzdafjpnt-singhanish8818-5070.vercel.app

# MongoDB Connection String (MongoDB Atlas or Local Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eduaccess?retryWrites=true&w=majority

# Authentication Security (JSON Web Token & Cookie Secrets)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_secure_cookie_signing_secret_here

# AI Provider Configuration (OpenAI or Groq / Compatible API)
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_groq_api_key_here
AI_MODEL=gpt-4o-mini
# Optional base URL override (e.g., https://api.groq.com/openai/v1 for Groq)
# AI_BASE_URL=https://api.groq.com/openai/v1

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_MAX=20

# File Upload Limits (in bytes, default 5MB = 5242880)
MAX_FILE_SIZE_BYTES=5242880
